rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Public read-only config. The site reads featureFlags/registration to
    // decide whether each sign-up flow is open; the flags are set by hand
    // in the console (or by an admin tool), never by the client. Cloud
    // Functions re-check the same flags before accepting a sign-up, so a
    // client that ignores this is still rejected server-side.
    match /featureFlags/{flagId} {
      allow read: if true;
      allow write: if false;
    }

    // All sign-up data (emailVerifications, workshopSignups,
    // competitionSignups, teams) is written and read exclusively by Cloud
    // Functions through the Admin SDK, which bypasses these rules entirely.
    // No client should ever read or write Firestore directly here.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
