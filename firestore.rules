rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Public read-only config. The site reads featureFlags/registration to
    // decide whether each sign-up flow is open; the flags are set by hand
    // in the console (or by an admin tool), never by the client. Cloud
    // Functions re-check the same flags before accepting a sign-up, so a
    // client that ignores this is still rejected server-side.
    match /featureFlags/{flagId} {
      allow read: if true;
      allow write: if false;
    }

    // Same flags for local development (VITE_ENVIRONMENT=development reads
    // the `_staging` collections). See DEVELOPMENT.md.
    match /featureFlags_staging/{flagId} {
      allow read: if true;
      allow write: if false;
    }

    // Compys trading game: odds and the leaderboard are public, so the
    // market document, the players and the trade feed are read-only to
    // everyone. Writes are still functions-only (balances and prices are
    // set exclusively by Cloud Functions in a transaction), and the
    // players' emails and session tokens live in jamPlayerSecrets, which
    // falls through to the deny-all rule below. Both the production and the
    // _staging collections are covered.
    match /jamMarket/{doc} {
      allow read: if true;
      allow write: if false;
    }
    match /jamMarket_staging/{doc} {
      allow read: if true;
      allow write: if false;
    }
    match /jamPlayers/{doc} {
      allow read: if true;
      allow write: if false;
    }
    match /jamPlayers_staging/{doc} {
      allow read: if true;
      allow write: if false;
    }
    match /jamTrades/{doc} {
      allow read: if true;
      allow write: if false;
    }
    match /jamTrades_staging/{doc} {
      allow read: if true;
      allow write: if false;
    }

    // All sign-up data (emailVerifications, workshopSignups,
    // competitionSignups, teams) and the jam game's secrets
    // (jamPlayerSecrets, jamVerifications) are written and read exclusively
    // by Cloud Functions through the Admin SDK, which bypasses these rules
    // entirely. No client should ever read or write Firestore directly here.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
